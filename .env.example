# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/library?retryWrites=true&w=majority

# Port for the Express server (Render sets PORT automatically, default is 4000 locally)
PORT=4000

# Secret key for signing JWT tokens (generate a long random string for production)
JWT_SECRET=your_super_secret_jwt_key_here

# (Optional) Frontend URL for CORS. Leave unset or empty to allow all origins (*)
# CLIENT_URL=https://your-frontend.vercel.app
